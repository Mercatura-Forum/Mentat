/// Mentat.mo - the contract: the one route by which a command reaches the log, on the chain.
///
/// Everything that decides anything is already written and already tested: `Contract.accept` reads
/// the clock once, binds the command to an encoding version, folds it, and appends the block. This
/// module adds no authority, no validation and no state of its own. What it adds is the substrate:
/// the clock's source, the persistence boundary, and the surface a caller can reach.
///
/// THE COMMAND ARRIVES AS ITS OWN CANONICAL BYTES, not as a Candid variant.
///
/// `submit(version, bytes)` decodes with `Encoding.read` and then accepts. The alternative - a
/// Candid parameter of the command type - would put a SECOND encoding of every command on the
/// wire, generated by a tool from the Motoko type, beside the frozen one the log stores and the
/// approval hash is taken over. Two encodings of one thing drift, and the day they do, a command a
/// caller signed and a command the log recorded would differ with nothing to say so. The bytes are
/// the command; this method takes the command.
///
/// It also means a client needs only the canonical writer to talk to this contract, which the
/// independent oracle already carries - so the harness that drives this on a chain shares no code
/// with it, exactly as the batteries' oracle does not.
///
/// The decoding and the wording of a refusal are `Boundary`'s, not this file's: they are the same
/// for every contract in the estate, and a front door written out twice is a front door that can
/// be written out differently.
///
/// THE CLOCK IS THE SUBSTRATE'S, AND THIS IS THE ONLY PLACE IT IS READ.
///
/// `ClockWiring` says a product runs on the calendar authority and that no other file may read a
/// clock; `tools/no_direct_clock.sh` fails the build if one does. This module is the exception the
/// rule is written around: it supplies the `Source` record, and nothing else in the tree has one.
/// On this substrate the clock advances with the block rather than with the wall, so the height is
/// derived from it here and the business date still comes from the calendar, never from either.
///
/// Attribution: Thebes Core Team. Licence: Apache 2.0.

import Array "mo:core/Array";
import CertifiedData "mo:core/CertifiedData";
import Int "mo:core/Int";
import Nat "mo:core/Nat";
import Nat8 "mo:core/Nat8";
import Nat16 "mo:core/Nat16";
import Nat32 "mo:core/Nat32";
import Nat64 "mo:core/Nat64";
import Principal "mo:core/Principal";
import Text "mo:core/Text";
import Time "mo:core/Time";

import Map "mo:core/Map";

import DL "mo:kernel/domain/DomainLog";
import Http "mo:kernel/net/Http";

import AcctFold "AcctFold";
import AuditIndex "AuditIndex";
import AcctRows "AcctRows";
import CtlFold "CtlFold";
import EsgFold "EsgFold";
import Bnd "Boundary";
import Clk "ClockWiring";
import Cmd "Command";
import Con "Contract";
import E "Enums";
import ES "EtaSubmit";
import FinFacts "FinFacts";
import FinFold "FinFold";
import PmtFold "PmtFold";
import PlatformFold "PlatformFold";
import FinRows "FinRows";
import Gate "Gate";
import Identity "Identity";
import HrFold "HrFold";
import Log "Log";
import RowStore "mo:kernel/rows/RowStore";
import Rows "Rows";
import St "State";
import SiteFold "SiteFold";
import BlogFold "BlogFold";
import ForumFold "ForumFold";
import GrpFold "GrpFold";
import GrpRows "GrpRows";
import Fields "Fields";
import TA "TextArena";

persistent actor {

  // ── the state, which is the log and a fold of it ──────────────────────────

  let log = Log.newState();
  let state = St.newState();

  /// The calendar the contract runs on. `#businessDate` with no date until one is rolled: a
  /// contract with no calendar has no date, and answering zero is how a dated act comes to be
  /// refused as being in the future.
  var config = Clk.genesisConfig(400_000);

  /// Whoever installed the contract. It is the only principal that may move the calendar, because
  /// at genesis there is no company yet and so nothing else to ask.
  var calendarAuthority : ?Principal = null;

  /// HOW MANY TIMES THIS CONTRACT HAS BEEN UPGRADED IN PLACE.
  ///
  /// It exists so that "the state survived an upgrade" is not a claim about an upgrade that never
  /// happened. A harness that only checked the fingerprint before and after would pass just as
  /// happily against a deploy that silently did nothing, which is the quietest way a test of
  /// persistence stops testing anything.
  var upgrades : Nat = 0;

  /// An upgrade from a layout retired before the audit index existed carries a log the index does not yet
  /// hold: it is caught up here, from the log, before anything is asked of the contract (`Contract.catchUpAudit`).
  /// A state whose index is current writes nothing.
  system func postupgrade() { upgrades += 1; ignore Con.catchUpAudit(log, state); certifyTip() };

  // ── the certified tip ─────────────────────────────────────────────────────
  //
  // After every block the log's tip is set as this contract's certified data, so a query may hand a
  // reader the subnet's certificate over it. A statement names the block it was sealed at and the
  // tip at that block; a reader that verifies the certificate with the network's root key, downloads
  // the blocks from the statement's to the certified tip and checks the chain, has the statement on
  // the log's own authority - with no update call anywhere.

  func certifyTip() {
    switch (DL.tipHash(log)) { case (?h) CertifiedData.set(h); case null {} }
  };

  func acceptCertified(caller : Principal, c : Cmd.Command) : { #ok : Con.Accepted; #err : Con.Refused } {
    let r = Con.accept(log, state, config, source, caller, c);
    certifyTip();
    r
  };

  // ── the substrate ─────────────────────────────────────────────────────────
  //
  // `transient` because a record of functions is not state and cannot be persisted; it is rebuilt
  // on every upgrade, which is right - it is the substrate's, not the contract's.

  transient let source : Clk.Source = {
    substrateNow = func() : Nat64 { Nat64.fromIntWrap(Time.now()) };
    // THE HEIGHT, FROM THE CLOCK. On this substrate the clock advances by about a second per
    // block, so the second is the height. Deriving it here and nowhere else is what keeps the
    // whole product's minute-of-day - a punch, a break, an interview - a function of the chain
    // rather than of whoever called.
    substrateHeight = func() : Nat { Int.abs(Time.now() / 1_000_000_000) };
    blockTimestamp = func() : ?Nat64 { null };
  };

  // ── the one way in ────────────────────────────────────────────────────────

  /// What a caller is told. The shape and the wording are `Boundary`'s, not this file's, so that
  /// every contract in the estate answers a submission the same way.
  public type Outcome = Bnd.Outcome;

  public shared ({ caller }) func submit(version : Nat8, bytes : Blob) : async Outcome {
    let out = Bnd.submit(log, state, config, source, caller, version, bytes);
    certifyTip();
    out
  };

  // ── a person signed in with a passkey ─────────────────────────────────────
  //
  // A browser signs every call with its own key; the person behind it signs in to Memphis with a passkey and carries
  // the session token Memphis minted for this contract's web address. `…As` methods act as the PERSON - the principal
  // Memphis derives for them under this contract's namespace - and never as the browser's key, so a role a company
  // gives a person follows the person from browser to browser (`Identity.mo`). The block records the person.

  /// The identity contract, its namespace and the web address its tokens are minted for; null until configured.
  let identity = Identity.newState();

  func person(caller : Principal, session : Text) : async* { #ok : Principal; #err : Text } {
    let ?token = Identity.tokenOf(session) else return #err("a session token is the hex Memphis gave the browser");
    let c = switch (Identity.begin(identity, token, caller, source)) {
      case (#known p) return #ok(p);
      case (#err why) return #err(why);
      case (#ask c) c;
    };
    let m : Identity.Memphis = actor (Principal.toText(Identity.principalOfCid(c.memphisCid)));
    let who = try {
      switch (await m.whoami_scoped_u(token, c.audience)) { case (#Err e) return #err(Identity.why(e)); case (#Ok w) w }
    } catch (_) { return #err("the identity contract did not answer; sign in again") };
    let derived = try {
      switch (await m.derive_principal_for_u(who.anchor_id, c.origin, c.version)) { case (#Err e) return #err(Identity.why(e)); case (#Ok b) b }
    } catch (_) { return #err("the identity contract did not answer; sign in again") };
    Identity.settle(identity, token, caller, c, who.session_expires_ns, derived, source)
  };

  func personCached(caller : Principal, session : Text) : ?Principal {
    let ?token = Identity.tokenOf(session) else return null;
    Identity.cached(identity, token, caller, source)
  };

  /// Name the identity contract, by the platform operator. The namespace and the version are set by the first call
  /// and never change, since they decide every person's principal; the identity contract and the web address may move.
  public shared ({ caller }) func configureIdentity(memphisCid : Nat, origin : Text, version : Nat64, audience : Text) : async { #ok; #err : Text } {
    switch (PlatformFold.current(state.platform)) {
      case (?p) { if (p.operator != caller) return #err("only the platform operator names the identity contract") };
      case null return #err("the log names no platform operator yet");
    };
    Identity.configure(identity, memphisCid, origin, version, audience)
  };

  public query func identityConfig() : async ?Identity.Config { identity.config };

  /// Sign in here: the person the session names, bound to the browser that signs this call.
  public shared ({ caller }) func openSession(session : Text) : async { #ok : Principal; #err : Text } {
    await* person(caller, session)
  };

  /// Sign out here, by the browser holding the session: the token is refused from then until its expiry, from every
  /// browser (Memphis's own sign-out only forgets it in the browser). True when an open session was signed out.
  public shared ({ caller }) func closeSession(session : Text) : async Bool {
    switch (Identity.tokenOf(session)) { case (?t) Identity.forget(identity, t, caller); case null false }
  };

  /// The person an open session names, asked by the browser holding it; null for any other.
  public shared query ({ caller }) func whoAmI(session : Text) : async ?Principal { personCached(caller, session) };

  /// `submit`, as the person the session signs in.
  public shared ({ caller }) func submitAs(session : Text, version : Nat8, bytes : Blob) : async Outcome {
    switch (await* person(caller, session)) {
      case (#err why) #err({ kind = "session"; reason = why });
      case (#ok p) {
        let out = Bnd.submit(log, state, config, source, p, version, bytes);
        certifyTip();
        out
      };
    }
  };

  // ── the calendar ──────────────────────────────────────────────────────────

  /// Move the business date. The FIRST caller becomes the calendar authority, because a contract
  /// that has just been installed has no company and no membership to check against; every caller
  /// after that must be it.
  public shared ({ caller }) func rollBusinessDate(day : Nat) : async { #ok : Nat; #err : Text } {
    switch (calendarAuthority) {
      case (?who) { if (who != caller) return #err("the calendar is " # Principal.toText(who) # "'s") };
      case null { calendarAuthority := ?caller };
    };
    switch (Clk.roll(config, day)) {
      case (#ok c) { config := c; #ok(day) };
      case (#err e) #err(Clk.errorText(e));
    }
  };

  // ── what a reader may ask ─────────────────────────────────────────────────

  public query func businessDate() : async ?Nat {
    switch (Clk.today(config, source)) { case (#ok d) ?d; case (#err _) null }
  };

  /// The substrate's clock and the height derived from it, as this contract sees them. The harness
  /// reads this across blocks to show that the clock advances with the chain and not with the wall.
  public query func clockReading() : async { now : Int; height : Nat } {
    { now = Time.now(); height = source.substrateHeight() }
  };

  public query func upgradeCount() : async Nat { upgrades };

  /// The platform operator the log names, the block it took the role at, and the principal a standing offer names;
  /// null while the log names none. The install reads it back right after its claim and stops if it is not the
  /// deployer.
  public query func platformOperator() : async ?{ operator : Principal; sinceBlock : Nat; offered : ?Principal } {
    switch (PlatformFold.current(state.platform)) {
      case (?p) ?{ operator = p.operator; sinceBlock = p.sinceBlock; offered = p.offered };
      case null null;
    }
  };

  public query func logLength() : async Nat { DL.length(log) };

  /// THE LOG FOUND BY COMPANY: one company's accepted blocks after `after`, in height order, a page at a time
  /// (`AuditIndex.mo`). Read by the company's administrator in standing and by the platform operator; anyone else
  /// is refused by the gate. Each entry names a height: the block itself (`blockBytes`), checked against the
  /// certified tip, is the evidence, and the entry only finds it.
  public shared query ({ caller }) func entriesByCompany(companyId : Nat, after : ?Nat, limit : Nat) : async { #ok : AuditIndex.EntryPage; #err : Text } {
    switch (St.entriesByCompany(state, caller, companyId, after, limit)) { case (#ok p) #ok(p); case (#err r) #err(Gate.refusalText(r)) }
  };

  /// THE LOG FOUND BY CALLER: a person's own accepted blocks, in every company or in one; or, read by a company's
  /// administrator in standing, the person's blocks in that company only.
  public shared query ({ caller }) func entriesByCaller(subject : Principal, companyId : ?Nat, after : ?Nat, limit : Nat) : async { #ok : AuditIndex.EntryPage; #err : Text } {
    switch (St.entriesByCaller(state, caller, subject, companyId, after, limit)) { case (#ok p) #ok(p); case (#err r) #err(Gate.refusalText(r)) }
  };

  /// The two reads above, as the person an open session names (`openSession` first: a query cannot ask Memphis).
  public shared query ({ caller }) func entriesByCompanyAs(session : Text, companyId : Nat, after : ?Nat, limit : Nat) : async { #ok : AuditIndex.EntryPage; #err : Text } {
    let ?p = personCached(caller, session) else return #err("no open session goes by that token from this browser; open one first");
    switch (St.entriesByCompany(state, p, companyId, after, limit)) { case (#ok x) #ok(x); case (#err r) #err(Gate.refusalText(r)) }
  };

  public shared query ({ caller }) func entriesByCallerAs(session : Text, subject : Principal, companyId : ?Nat, after : ?Nat, limit : Nat) : async { #ok : AuditIndex.EntryPage; #err : Text } {
    let ?p = personCached(caller, session) else return #err("no open session goes by that token from this browser; open one first");
    switch (St.entriesByCaller(state, p, subject, companyId, after, limit)) { case (#ok x) #ok(x); case (#err r) #err(Gate.refusalText(r)) }
  };

  public query func tipHash() : async ?Blob { DL.tipHash(log) };

  /// One block's bytes, exactly as they are stored. This is what the independent oracle reads: it
  /// parses the block layout itself and recomputes the product's figures from them, sharing no code
  /// with the contract. THE RAW LOG IS READ BY THE SAME RULE AS THE RECORDS: served to the platform operator, the administrator of the block's company and the block's own caller, and
  /// a block of a person's payroll, medical, disciplinary or family record to nobody by query (`Personal.mo`). The
  /// tip and its certificate stay public, so anyone still checks that the chain is whole.
  public shared query ({ caller }) func blockBytes(index : Nat) : async { #ok : Blob; #err : Text } { Con.blockFor(log, state, caller, index) };

  /// THE DRAFTS MADE FOR THE CALLER in one company, a page at a time (`DraftFold`); the act a draft holds and its
  /// note withheld where the act is a personal record's.
  public shared query ({ caller }) func draftsFor(companyId : Nat, after : ?Nat, limit : Nat) : async { #ok : { drafts : [St.DraftView]; next : ?Nat }; #err : Text } {
    St.draftsFor(state, caller, companyId, after, limit)
  };

  /// `draftsFor`, as the person an open session names.
  public shared query ({ caller }) func draftsForAs(session : Text, companyId : Nat, after : ?Nat, limit : Nat) : async { #ok : { drafts : [St.DraftView]; next : ?Nat }; #err : Text } {
    let ?p = personCached(caller, session) else return #err("no open session goes by that token from this browser; open one first");
    St.draftsFor(state, p, companyId, after, limit)
  };

  /// THE READ METHOD, the mirror of `submit`: `request` is the
  /// canonical bytes of a `ReadSurface.Request` under `version` - a page of one kind of record in one company from a
  /// cursor, or one record - and the reply is the page, naming the log's height and tip it was read at, so a client
  /// holds it to `certifiedTip`. Each kind is served to the class of reader `ReadKinds` names for it, deny by default;
  /// a person's payroll, medical, disciplinary or family record to nobody by query.
  public shared query ({ caller }) func read(version : Nat8, request : Blob) : async { #ok : Blob; #err : Text } {
    Con.read(log, state, caller, version, request)
  };

  /// `read`, as the person an open session names.
  public shared query ({ caller }) func readAs(session : Text, version : Nat8, request : Blob) : async { #ok : Blob; #err : Text } {
    let ?p = personCached(caller, session) else return #err("no open session goes by that token from this browser; open one first");
    Con.read(log, state, p, version, request)
  };

  /// `blockBytes`, as the person an open session names.
  public shared query ({ caller }) func blockBytesAs(session : Text, index : Nat) : async { #ok : Blob; #err : Text } {
    let ?p = personCached(caller, session) else return #err("no open session goes by that token from this browser; open one first");
    Con.blockFor(log, state, p, index)
  };

  /// Every byte of state a command can move, in one digest. Two contracts that agree here hold the
  /// same rows; a contract that agrees with itself across an upgrade kept its state.
  public query func fingerprint() : async Blob { St.fingerprintHash(state) };

  /// The log's tip under the subnet's certificate. The certificate is null outside a query call.
  public query func certifiedTip() : async { tip : ?Blob; certificate : ?Blob } {
    { tip = DL.tipHash(log); certificate = CertifiedData.getCertificate() }
  };

  /// A published statement with its lines, the block and tip it is anchored to, and the current tip
  /// under the certificate - everything a reader needs to verify it off-chain from the blocks.
  public type StatementView = {
    companyId : Nat; kind : Text; fromDay : Nat; throughDay : Nat; state : Text;
    atBlock : Nat; tip : Blob; hash : Blob;
    lines : [{ accountId : Nat; debit : Nat; credit : Nat }];
    currentTip : ?Blob; certificate : ?Blob;
  };
  public query func statement(statementId : Nat) : async ?StatementView {
    switch (RowStore.get<AcctRows.Statement>(state.acct.statements, AcctRows.statement, statementId)) {
      case null null;
      case (?x) ?{
        companyId = x.companyId;
        kind = switch (x.kind) { case (#trialBalance) "trialBalance"; case (#balanceSheet) "balanceSheet"; case (#incomeStatement) "incomeStatement" };
        fromDay = x.fromDay; throughDay = x.throughDay;
        state = switch (x.state) { case (#building) "building"; case (#published) "published"; case (#cancelled) "cancelled" };
        atBlock = x.atBlock; tip = x.tip; hash = x.hash;
        lines = Array.map<(Nat, AcctRows.StatementLine), { accountId : Nat; debit : Nat; credit : Nat }>(
          AcctFold.statementLines(state.acct, statementId), func(p) { { accountId = p.1.accountId; debit = p.1.debit; credit = p.1.credit } });
        currentTip = DL.tipHash(log); certificate = CertifiedData.getCertificate();
      };
    }
  };

  /// A published consolidation with the member statements it was read from, its elimination
  /// entries and its lines by account code, the block and tip it is anchored to, and the current
  /// tip under the certificate - everything a reader needs to verify it off-chain from the blocks
  /// and the member statements.
  public type ConsolidationView = {
    groupId : Nat; companyId : Nat; kind : Text; fromDay : Nat; throughDay : Nat; state : Text;
    atBlock : Nat; tip : Blob; hash : Blob; difference : Int;
    members : [{ companyId : Nat; statementId : Nat; atBlock : Nat; hash : Blob }];
    eliminations : [{ companyId : Nat; counterpartyId : Nat; code : Text; debit : Nat; credit : Nat }];
    lines : [{ code : Text; debit : Nat; credit : Nat }];
    currentTip : ?Blob; certificate : ?Blob;
  };
  public query func consolidation(consolidationId : Nat) : async ?ConsolidationView {
    switch (RowStore.get<GrpRows.Consolidation>(state.grp.consolidations, GrpRows.consolidation, consolidationId)) {
      case null null;
      case (?x) ?{
        groupId = x.groupId; companyId = x.companyId;
        kind = switch (x.kind) { case (#trialBalance) "trialBalance"; case (#balanceSheet) "balanceSheet"; case (#incomeStatement) "incomeStatement" };
        fromDay = x.fromDay; throughDay = x.throughDay;
        state = GrpFold.stateName(x.state);
        atBlock = x.atBlock; tip = x.tip; hash = x.hash; difference = Fields.zag(x.difference);
        members = Array.map<(Nat, GrpRows.ConsolidationMember), { companyId : Nat; statementId : Nat; atBlock : Nat; hash : Blob }>(
          GrpFold.consolidationMembersOf(state.grp, consolidationId), func(p) { { companyId = p.1.companyId; statementId = p.1.statementId; atBlock = p.1.atBlock; hash = p.1.hash } });
        eliminations = Array.map<(Nat, GrpRows.Elimination), { companyId : Nat; counterpartyId : Nat; code : Text; debit : Nat; credit : Nat }>(
          GrpFold.eliminationsOf(state.grp, consolidationId), func(p) { { companyId = p.1.companyId; counterpartyId = p.1.counterpartyId; code = codeText(p.1.code); debit = p.1.debit; credit = p.1.credit } });
        lines = Array.map<(Nat, GrpRows.ConsolidationLine), { code : Text; debit : Nat; credit : Nat }>(
          GrpFold.linesOf(state.grp, consolidationId), func(p) { { code = codeText(p.1.code); debit = p.1.debit; credit = p.1.credit } });
        currentTip = DL.tipHash(log); certificate = CertifiedData.getCertificate();
      };
    }
  };
  /// A screening run with a page of its findings (`CtlFold.screening`), and the current tip under the certificate: a
  /// reader walks the pages, restates the chain and the run's hash from the view alone, and checks the tip against
  /// the blocks it downloads - with no update call.
  public type ScreeningView = CtlFold.Screening and { currentTip : ?Blob; certificate : ?Blob };
  public query func screening(runId : Nat, afterFinding : Nat, limit : Nat) : async { #ok : ScreeningView; #err : Text } {
    switch (CtlFold.screening(state.ctl, state.arena, runId, afterFinding, limit)) {
      case (#err e) #err(e);
      case (#ok v) #ok({ v with currentTip = DL.tipHash(log); certificate = CertifiedData.getCertificate() });
    }
  };

  /// An ESG run with a page of its figures (`EsgFold.statement`), and the current tip under the certificate: a reader
  /// walks the pages, orders the figures by key, restates the chain and the run's hash from the view alone, and
  /// checks the tip against the blocks it downloads - with no update call.
  public type EsgStatementView = EsgFold.Statement and { currentTip : ?Blob; certificate : ?Blob };
  public query func esgStatement(runId : Nat, afterFigure : Nat, limit : Nat) : async { #ok : EsgStatementView; #err : Text } {
    switch (EsgFold.statement(state.esg, runId, afterFigure, limit)) {
      case (#err e) #err(e);
      case (#ok v) #ok({ v with currentTip = DL.tipHash(log); certificate = CertifiedData.getCertificate() });
    }
  };
  /// A sealed ESG run disclosed (`EsgFold.disclosure`): GRI 305/302/303/306 and ESRS E1-5 and E1-6 figures, and the
  /// environmental answers of the Financial Regulatory Authority's form, with E3.3 against `priorRunId` (0 for none).
  public type EsgDisclosureView = EsgFold.Disclosure and { currentTip : ?Blob; certificate : ?Blob };
  public query func esgDisclosure(runId : Nat, priorRunId : Nat) : async { #ok : EsgDisclosureView; #err : Text } {
    switch (EsgFold.disclosure(state.esg, runId, priorRunId)) {
      case (#err e) #err(e);
      case (#ok v) #ok({ v with currentTip = DL.tipHash(log); certificate = CertifiedData.getCertificate() });
    }
  };

  /// An account code's text; the result line's zero code is "".
  func codeText(code : Blob) : Text { switch (Fields.textOfField(code)) { case (?t) t; case null "" } };

  // ── the tax authority: the one place a credential is held, and the two calls ──
  //
  // THE CREDENTIAL IS THE ACTOR'S, NOT THE LOG'S. The client id and secret the authority issued to
  // this system are installed by the company's administrator through a method that writes no block
  // and no row: they are never on the log, never in a row, never in a command's bytes. They are
  // read at the moment the login request is built and nowhere else. `tools/outcall_and_secrets.sh`
  // checks that no command or row carries a credential-shaped field; this variable is the edge that
  // rule points at.
  //
  // SUBMIT AND READ ARE TWO MESSAGES on this substrate: an outbound call is submitted in one update
  // and its answer read in a later one. The filing is therefore three acts by the caller - 
  // `beginEtaLogin`, then `submitEtaFiling` once the token is in, then `readEtaAnswer` - each of
  // which returns at once and says what to do next. Every write the record needs (the submission
  // block, the acknowledgement block) is a command through the fold, made in the message that reads
  // the answer, before any further await, so it persists.

  type Credential = { identityEndpoint : Text; clientId : Text; clientSecret : Text };
  var etaCredentials : Map.Map<Nat, Credential> = Map.empty<Nat, Credential>();
  transient var etaTokens : Map.Map<Nat, { token : Text; height : Nat; expiresIn : Nat }> = Map.empty<Nat, { token : Text; height : Nat; expiresIn : Nat }>();
  transient var etaLogins : Map.Map<Nat, Http.Handle> = Map.empty<Nat, Http.Handle>();
  transient var etaSubmissions : Map.Map<Nat, Http.Handle> = Map.empty<Nat, Http.Handle>();

  func submitErrorText(e : Http.SubmitError) : Text {
    switch (e) {
      case (#rejected) "the request was rejected (a malformed URL or scheme, a bound out of range, or too many headers)";
      case (#notActive) "outbound calls are not active on this chain";
      case (#tooManyInFlight) "too many outbound calls are in flight";
    }
  };

  /// The request as the substrate takes it: a POST at the quorum the module decided, agreeing on
  /// the body only (the authority stamps a date and a request id in its headers).
  func toHttp(r : ES.Request) : Http.Request {
    var h = Http.post(r.url, r.body);
    for ((n, v) in r.headers.vals()) { h := Http.withHeader(h, n, v) };
    Http.withMaxResponseBytes(Http.withAgreement(Http.withQuorum(h, Nat32.fromNat(r.quorum)), #bodyOnly), r.maxResponseBytes)
  };

  func isCompanyAdmin(companyId : Nat, p : Principal) : Bool {
    switch (HrFold.membershipOf(state.hr, companyId, p)) {
      case (?(_, m)) m.companyRole == #CompanyAdmin;
      case null false;
    }
  };

  func finCtx(caller : Principal) : FinFold.Ctx {
    let day = switch (Clk.today(config, source)) { case (#ok d) d; case (#err _) 0 };
    {
      fin = state.fin; acct = state.acct; ord = state.ord; companies = state.companies;
      arena = state.arena; block = DL.length(log); caller; day;
      companyExists = func(id : Nat) : Bool { RowStore.has<Rows.Company>(state.companies, Rows.company, id) };
      accountOfIban = func(companyId : Nat, iban : Text) : ?(Nat, Text) { PmtFold.accountByIban(state.pmt, companyId, iban) };
      partnerOfIban = func(companyId : Nat, iban : Text) : ?Nat { PmtFold.partnerByIban(state.pmt, companyId, iban) };
      // the query context writes nothing: the credit hooks are never reached from a read
      creditSettled = func(_ : Nat, _ : Nat) {};
      creditUnsettled = func(_ : Nat, _ : Nat) {};
    }
  };

  func installEtaCredentialBy(caller : Principal, companyId : Nat, identityEndpoint : Text, clientId : Text, clientSecret : Text) : { #ok; #err : Text } {
    if (not isCompanyAdmin(companyId, caller)) return #err("only the company's administrator installs its credential");
    if (Text.size(clientId) == 0 or Text.size(clientSecret) == 0 or Text.size(identityEndpoint) == 0) return #err("the identity endpoint, client id and secret are all required");
    Map.add(etaCredentials, Nat.compare, companyId, { identityEndpoint; clientId; clientSecret });
    #ok
  };

  func beginEtaLoginBy(caller : Principal, companyId : Nat) : { #ok; #err : Text } {
    if (not isCompanyAdmin(companyId, caller)) return #err("only the company's administrator files");
    let ?cred = Map.get(etaCredentials, Nat.compare, companyId) else return #err("no credential is installed for company " # Nat.toText(companyId));
    switch (Http.submitV2(toHttp(ES.loginRequest(cred.identityEndpoint, cred.clientId, cred.clientSecret)))) {
      case (#ok h) { Map.add(etaLogins, Nat.compare, companyId, h); #ok };
      case (#err e) #err("the substrate refused the login request: " # submitErrorText(e));
    }
  };

  func submitEtaFilingBy(caller : Principal, companyId : Nat, filingId : Nat) : { #ok : { submitted : Bool; note : Text }; #err : Text } {
    if (not isCompanyAdmin(companyId, caller)) return #err("only the company's administrator files");
    // the token: pending login answered, or one already held and not expired
    switch (Map.get(etaLogins, Nat.compare, companyId)) {
      case (?h) {
        switch (Http.pollV2(h)) {
          case (#pending) return #ok({ submitted = false; note = "the login is still pending; ask again" });
          case (#tooLarge) { ignore Map.delete(etaLogins, Nat.compare, companyId); ignore Http.free(h); return #err("the login answer exceeded the bound") };
          case (#unknownHandle) { ignore Map.delete(etaLogins, Nat.compare, companyId); return #err("the login's handle is no longer known to the substrate; begin again") };
          case (#ready r) {
            ignore Map.delete(etaLogins, Nat.compare, companyId);
            ignore Http.free(h);
            switch (ES.readToken(Nat16ToNat(r.status), r.body)) {
              case (#err e) return #err(e);
              case (#ok t) Map.add(etaTokens, Nat.compare, companyId, { token = t.token; height = source.substrateHeight(); expiresIn = t.expiresIn });
            };
          };
        };
      };
      case null {};
    };
    let ?tok = Map.get(etaTokens, Nat.compare, companyId) else return #err("no token: begin a login first");
    if (tok.expiresIn > 0 and source.substrateHeight() > tok.height + tok.expiresIn) {
      ignore Map.delete(etaTokens, Nat.compare, companyId);
      return #err("the token has expired: begin a login again");
    };
    let c = finCtx(caller);
    let ?(_, cfg) = FinFold.configOf(c, companyId) else return #err("company " # Nat.toText(companyId) # " has no authority endpoint configured");
    let ?endpoint = TA.get(state.arena, cfg.endpoint) else return #err("no endpoint");
    let body = switch (FinFold.submissionBodyOf(c, filingId)) { case (#ok b) b; case (#err e) return #err(FinFold.refusalText(e)) };
    let ?x = RowStore.get<FinRows.EtaFiling>(state.fin.filings, FinRows.etaFiling, filingId) else return #err("no filing " # Nat.toText(filingId));
    // THE RECORD FIRST: the submission as a command through the fold, refused by it if the filing
    // is not sealed or the digest moved. Only then the request.
    switch (acceptCertified(caller, #recordEtaSubmission { companyId; filingId; payloadHash = x.payloadHash })) {
      case (#err r) return #err(Con.refusedText(r));
      case (#ok _) {};
    };
    switch (Http.submitV2(toHttp(ES.submissionRequest(endpoint, tok.token, body)))) {
      case (#ok h) { Map.add(etaSubmissions, Nat.compare, filingId, h); #ok({ submitted = true; note = "submitted; read the answer with readEtaAnswer" }) };
      case (#err e) #err("the substrate refused the submission request: " # submitErrorText(e));
    }
  };

  func readEtaAnswerBy(caller : Principal, companyId : Nat, filingId : Nat) : { #ok : { recorded : Bool; note : Text }; #err : Text } {
    if (not isCompanyAdmin(companyId, caller)) return #err("only the company's administrator files");
    let ?h = Map.get(etaSubmissions, Nat.compare, filingId) else return #err("no submission is pending for filing " # Nat.toText(filingId));
    switch (Http.pollV2(h)) {
      case (#pending) #ok({ recorded = false; note = "the answer is still pending; ask again" });
      case (#tooLarge) { ignore Map.delete(etaSubmissions, Nat.compare, filingId); ignore Http.free(h); #err("the answer exceeded the bound") };
      case (#unknownHandle) { ignore Map.delete(etaSubmissions, Nat.compare, filingId); #err("the submission's handle is no longer known to the substrate") };
      case (#ready r) {
        ignore Map.delete(etaSubmissions, Nat.compare, filingId);
        ignore Http.free(h);
        let ?x = RowStore.get<FinRows.EtaFiling>(state.fin.filings, FinRows.etaFiling, filingId) else return #err("no filing");
        let facts : FinFacts.FilingResultFacts = switch (ES.readSubmission(Nat16ToNat(r.status), r.body)) {
          // NOT AN ANSWER TO FOLD. The authority saw an identical submission moments before - on
          // this substrate, from another validator - and its answer to that one stands. The filing
          // stays submitted and nothing is written; the first submission's answer is recorded by
          // `recordEtaResult` from the authority's own record of the document.
          case (#duplicate d) return #ok({ recorded = false; note = "not folded: the authority answered " # d # "; the first submission's answer stands and is recorded from the authority's record of the document" });
          case (#err e) ({ companyId; filingId; payloadHash = x.payloadHash; accepted = false; uuid = ""; submissionId = ""; longId = ""; reason = e });
          case (#ok a) {
            if (a.accepted.size() > 0) {
              { companyId; filingId; payloadHash = x.payloadHash; accepted = true; uuid = a.accepted[0].uuid; submissionId = a.submissionUuid; longId = a.accepted[0].longId; reason = "" }
            } else if (a.rejected.size() > 0) {
              { companyId; filingId; payloadHash = x.payloadHash; accepted = false; uuid = ""; submissionId = a.submissionUuid; longId = ""; reason = a.rejected[0].code # ": " # a.rejected[0].message }
            } else {
              { companyId; filingId; payloadHash = x.payloadHash; accepted = false; uuid = ""; submissionId = a.submissionUuid; longId = ""; reason = "the authority accepted and rejected nothing" }
            }
          };
        };
        switch (acceptCertified(caller, #recordEtaResult { facts })) {
          case (#err e) #err(Con.refusedText(e));
          case (#ok _) #ok({ recorded = true; note = if (facts.accepted) "accepted as " # facts.uuid else "rejected: " # facts.reason });
        }
      };
    }
  };

  // The four acts above, by the signer of the call, or (`…As`) by the person a Memphis session signs in (`Identity.mo`).
  /// Install the authority's client credential for a company. The caller must be the company's
  /// administrator. No block, no row.
  public shared ({ caller }) func installEtaCredential(companyId : Nat, identityEndpoint : Text, clientId : Text, clientSecret : Text) : async { #ok; #err : Text } { installEtaCredentialBy(caller, companyId, identityEndpoint, clientId, clientSecret) };
  public shared ({ caller }) func installEtaCredentialAs(session : Text, companyId : Nat, identityEndpoint : Text, clientId : Text, clientSecret : Text) : async { #ok; #err : Text } {
    switch (await* person(caller, session)) { case (#ok p) installEtaCredentialBy(p, companyId, identityEndpoint, clientId, clientSecret); case (#err why) #err(why) }
  };

  /// Begin the login: the client-credentials request goes out at quorum one; the answer is read
  /// by `submitEtaFiling`.
  public shared ({ caller }) func beginEtaLogin(companyId : Nat) : async { #ok; #err : Text } { beginEtaLoginBy(caller, companyId) };
  public shared ({ caller }) func beginEtaLoginAs(session : Text, companyId : Nat) : async { #ok; #err : Text } {
    switch (await* person(caller, session)) { case (#ok p) beginEtaLoginBy(p, companyId); case (#err why) #err(why) }
  };

  /// Submit a sealed filing. If a login is pending its answer is read first and the token kept for
  /// its hour. The submission is recorded on the log by the fold BEFORE the request is submitted,
  /// so the record says a submission was made even if the answer never comes back; the answer is
  /// then read by `readEtaAnswer`.
  public shared ({ caller }) func submitEtaFiling(companyId : Nat, filingId : Nat) : async { #ok : { submitted : Bool; note : Text }; #err : Text } { submitEtaFilingBy(caller, companyId, filingId) };
  public shared ({ caller }) func submitEtaFilingAs(session : Text, companyId : Nat, filingId : Nat) : async { #ok : { submitted : Bool; note : Text }; #err : Text } {
    switch (await* person(caller, session)) { case (#ok p) submitEtaFilingBy(p, companyId, filingId); case (#err why) #err(why) }
  };

  /// Read the authority's answer to a submitted filing and record it through the fold.
  public shared ({ caller }) func readEtaAnswer(companyId : Nat, filingId : Nat) : async { #ok : { recorded : Bool; note : Text }; #err : Text } { readEtaAnswerBy(caller, companyId, filingId) };
  public shared ({ caller }) func readEtaAnswerAs(session : Text, companyId : Nat, filingId : Nat) : async { #ok : { recorded : Bool; note : Text }; #err : Text } {
    switch (await* person(caller, session)) { case (#ok p) readEtaAnswerBy(p, companyId, filingId); case (#err why) #err(why) }
  };

  func Nat16ToNat(n : Nat16) : Nat { Nat16.toNat(n) };

  /// The sealed submission body a filing would send, for a relay that files from outside the
  /// contract and records the answer with `recordEtaResult`. Read-only.
  public query func etaSubmissionBody(filingId : Nat) : async { #ok : Text; #err : Text } {
    switch (FinFold.submissionBodyOf(finCtx(Principal.fromText("2vxsx-fae")), filingId)) {
      case (#ok b) #ok(b);
      case (#err e) #err(FinFold.refusalText(e));
    }
  };

  // ── what the boundary delivers ────────────────────────────────────────────

  public type Request = { method : Text; url : Text; headers : [(Text, Text)]; body : Blob };
  public type Response = { status_code : Nat16; headers : [(Text, Text)]; body : Blob };

  /// A read-only surface, and an instrument.
  ///
  /// It echoes the url and the headers it was given. That is not decoration: the boundary in front
  /// of this contract delivers the PATH ONLY - no headers, no query string - and a design that put
  /// anything load-bearing in either would work in every battery and fail in front of a browser.
  /// The careers page's proof-of-work stamp is in the command's body for that reason, and this
  /// method is what lets a test show the reason rather than assert it.
  ///
  /// Nothing is submitted here. A submission changes state, this cannot, and an applicant reaches
  /// `submit` as an ingress call with no account of any kind.
  public query func http_request(r : Request) : async Response {
    // THE SITE: `/sites/<slug>/<path>` is a company's page, served from the document it was published
    // from, with the publication block and the fingerprint the fold recomputed in the headers
    switch (SiteFold.route(r.url)) {
      case (?(slug, path)) {
        switch (Rows.slugField(slug)) {
          case (?field) {
            switch (St.companyBySlug(state, field)) {
              case (?(companyId, _)) {
                // THE BLOG under the site: the index of the live posts newest first, or one post by its slug
                switch (BlogFold.routeBlog(path)) {
                  case (?#index) {
                    return { status_code = 200; headers = [("content-type", "text/html; charset=utf-8")]; body = Text.encodeUtf8(BlogFold.index(state.blog, state.arena, companyId, slug)) };
                  };
                  case (?#post(postSlug)) {
                    switch (BlogFold.serve(state.blog, state.evs, state.arena, companyId, postSlug)) {
                      case (?p) {
                        return { status_code = 200; body = p.body; headers = [
                          ("content-type", p.contentType), ("x-mentat-block", Nat.toText(p.block)), ("x-mentat-revision", Nat.toText(p.version)),
                          ("x-mentat-fingerprint", SiteFold.hexOf(p.fingerprint))] };
                      };
                      case null {};
                    };
                  };
                  case null {};
                };
                // THE FORUM under the site: the boards, a board's topics pinned first and the latest word first, or one thread
                switch (ForumFold.routeForum(path)) {
                  case (?#boards) {
                    return { status_code = 200; headers = [("content-type", "text/html; charset=utf-8")]; body = Text.encodeUtf8(ForumFold.boards(state.forum, state.arena, companyId, slug)) };
                  };
                  case (?#board(boardSlug)) {
                    switch (ForumFold.board(state.forum, state.arena, companyId, slug, boardSlug)) {
                      case (?html) { return { status_code = 200; headers = [("content-type", "text/html; charset=utf-8")]; body = Text.encodeUtf8(html) } };
                      case null {};
                    };
                  };
                  case (?#topic(boardSlug, topicId)) {
                    switch (ForumFold.thread(state.forum, state.arena, companyId, boardSlug, topicId)) {
                      case (?html) { return { status_code = 200; headers = [("content-type", "text/html; charset=utf-8")]; body = Text.encodeUtf8(html) } };
                      case null {};
                    };
                  };
                  case null {};
                };
                switch (SiteFold.serve(state.site, state.evs, state.arena, companyId, path)) {
                  case (?p) {
                    return { status_code = 200; body = p.body; headers = [
                      ("content-type", p.contentType), ("x-mentat-block", Nat.toText(p.block)), ("x-mentat-version", Nat.toText(p.version)),
                      ("x-mentat-fingerprint", SiteFold.hexOf(p.fingerprint))] };
                  };
                  case null {};
                };
              };
              case null {};
            };
          };
          case null {};
        };
        return { status_code = 404; headers = [("content-type", "text/plain")]; body = Text.encodeUtf8("no such page") };
      };
      case null {};
    };
    var names = "";
    for (h in r.headers.vals()) { names #= (if (names == "") "" else ",") # h.0 };
    let body = "{\"url\":\"" # r.url # "\""
             # ",\"method\":\"" # r.method # "\""
             # ",\"header_count\":" # Nat.toText(r.headers.size())
             # ",\"header_names\":\"" # names # "\""
             # ",\"body_bytes\":" # Nat.toText(r.body.size())
             # ",\"blocks\":" # Nat.toText(DL.length(log))
             # "}";
    { status_code = 200; headers = [("content-type", "application/json")]; body = Text.encodeUtf8(body) }
  };
}
