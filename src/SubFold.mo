/// SubFold.mo - subscriptions: a recurring order with a period, invoices generated by a bounded run on
/// the calendar, proration on change, a subscription closed by its customer.
///
/// A SUBSCRIPTION IS A RECURRING SALE: to a customer, of a category, so much at a price per period, in
/// a currency, at a tax rate, every civil month, quarter or year from its start day. Its periods are
/// THE CALENDAR'S: the k-th period begins on the start day's day of the month, k periods on, clamped
/// to the month's length - a subscription begun on the 31st of January renews on the 28th of
/// February and the 31st of March, not on thirty-day marks.
///
/// THE RUN INVOICES IT. One person opens a run through a day that has come, naming the journal;
/// another slices it. Each slice takes the head of the active subscriptions by the day their next
/// period begins, up to a limit, and for each raises one sale per period begun by the run's day - at
/// most so many periods a slice, so a subscription years behind is caught up over slices and not in
/// one. Every sale is asked about whole first - partner, line, price, the customer's credit, the
/// accounts, the entry - and a run whose customer is past their limit refuses whole, with nothing
/// written: the operator closes the subscription or raises the limit. Then each is placed, confirmed
/// and invoiced THROUGH THE ORDER FOLD, dated the run's day, so a subscription's invoice is a sale like
/// any other, in the ledger through the ledger's own fold, and the credit terms see it as they see
/// every sale. A subscription moves along the run's head as it is invoiced, and the run closes when
/// the head is empty.
///
/// PRORATION ON CHANGE: what is sold and at what price may change, effective today. Inside a period
/// already invoiced, an INCREASE is prorated - the difference in the period's charge, times the days
/// remaining over the days in the period, to the minor unit half to even - and invoiced at once;
/// a decrease takes effect from the next period and refunds nothing. Outside an invoiced period the
/// change simply prices the next invoice.
///
/// CLOSED, a subscription is invoiced no more; the period already invoiced is not refunded.
///
/// Attribution: Thebes Core Team. Licence: Apache 2.0.

import List "mo:core/List";
import Nat "mo:core/Nat";
import Principal "mo:core/Principal";
import Runtime "mo:core/Runtime";
import Text "mo:core/Text";

import CivilDate "mo:kernel/num/CivilDate";
import Dec "mo:kernel/num/Dec";
import Page "mo:kernel/rows/Page";
import RowStore "mo:kernel/rows/RowStore";
import Lookup "Lookup";

import AR "AcctRows";
import E "Enums";
import F "Fields";
import OF "OrderFacts";
import OFold "OrderFold";
import OR "OrderRows";
import PE "PayEngine";
import SB "SubFacts";
import SBR "SubRows";
import TA "TextArena";
import W "Widths";

module {

  public type Refusal = {
    #wrongCompany : { expected : Nat; found : Nat };
    #nameRequired : { what : Text };
    #textDoesNotFit : { field : Text; value : Text; max : Nat };
    #codeDoesNotFit : { code : Text; max : Nat };
    #noSuchPartner : { partnerId : Nat };
    #partnerNotACustomer : { partnerId : Nat };
    #noSuchCategory : { categoryId : Nat };
    #quantityZero;
    #priceRequired;
    #rateBound : { what : Text; value : Nat; max : Nat };
    #dayTooLarge : { day : Nat };
    #horizonNotReached : { throughDay : Nat; day : Nat };
    #noSuchSubscription : { subscriptionId : Nat };
    #subscriptionClosed : { subscriptionId : Nat };
    /// A change that changes nothing.
    #noChange : { subscriptionId : Nat };
    #noSuchJournal : { journalId : Nat };
    #subscriptionRunOpen : { companyId : Nat; runId : Nat };
    #noSuchSubscriptionRun : { runId : Nat };
    #runNotInState : { runId : Nat; state : Text; wanted : Text };
    /// The person who opened the run slicing it.
    #selfInvoicing : { opener : Principal };
    #sliceBound : { limit : Nat; max : Nat };
    /// The order fold's own refusal of a sale the run or a change would raise.
    #order : OFold.Refusal;
  };

  public func refusalText(r : Refusal) : Text {
    switch (r) {
      case (#wrongCompany { expected; found }) "company " # Nat.toText(found) # " is not company " # Nat.toText(expected);
      case (#nameRequired { what }) "a " # what # " must have a name";
      case (#textDoesNotFit { field; value; max }) field # " \"" # value # "\" exceeds " # Nat.toText(max) # " bytes";
      case (#codeDoesNotFit { code; max }) "code \"" # code # "\" is empty or exceeds " # Nat.toText(max) # " bytes";
      case (#noSuchPartner { partnerId }) "no partner " # Nat.toText(partnerId);
      case (#partnerNotACustomer { partnerId }) "partner " # Nat.toText(partnerId) # " is not a customer";
      case (#noSuchCategory { categoryId }) "no category " # Nat.toText(categoryId);
      case (#quantityZero) "a subscription of nothing";
      case (#priceRequired) "a subscription at no price";
      case (#rateBound { what; value; max }) what # " of " # Nat.toText(value) # " exceeds " # Nat.toText(max);
      case (#dayTooLarge { day }) "day " # Nat.toText(day) # " does not fit its field";
      case (#horizonNotReached { throughDay; day }) "day " # Nat.toText(throughDay) # " has not come; it is day " # Nat.toText(day);
      case (#noSuchSubscription { subscriptionId }) "no subscription " # Nat.toText(subscriptionId);
      case (#subscriptionClosed { subscriptionId }) "subscription " # Nat.toText(subscriptionId) # " is closed";
      case (#noChange { subscriptionId }) "subscription " # Nat.toText(subscriptionId) # " already sells that at that price";
      case (#noSuchJournal { journalId }) "no open journal " # Nat.toText(journalId);
      case (#subscriptionRunOpen { companyId; runId }) "company " # Nat.toText(companyId) # " has subscription run " # Nat.toText(runId) # " open";
      case (#noSuchSubscriptionRun { runId }) "no subscription run " # Nat.toText(runId);
      case (#runNotInState { runId; state; wanted }) "subscription run " # Nat.toText(runId) # " is " # state # ", not " # wanted;
      case (#selfInvoicing { opener }) Principal.toText(opener) # " opened this run and cannot raise its invoices";
      case (#sliceBound { limit; max }) "a slice of " # Nat.toText(limit) # " is not between 1 and " # Nat.toText(max);
      case (#order r) OFold.refusalText(r);
    }
  };

  public type Stores = {
    var subscriptions : RowStore.Store;
    var invoices : RowStore.Store;
    var runs : RowStore.Store;
    var nextSubscriptionId : Nat;
    var nextInvoiceId : Nat;
    var nextRunId : Nat;
  };

  public func newStores() : Stores {
    {
      var subscriptions = RowStore.newStore<SBR.Subscription>(SBR.subscription);
      var invoices = RowStore.newStore<SBR.SubscriptionInvoice>(SBR.subscriptionInvoice);
      var runs = RowStore.newStore<SBR.SubscriptionRun>(SBR.subscriptionRun);
      var nextSubscriptionId = 1;
      var nextInvoiceId = 1;
      var nextRunId = 1;
    }
  };

  public type Ctx = {
    sub : Stores;
    ord : { var partners : RowStore.Store; var categories : RowStore.Store; var orders : RowStore.Store };
    arena : TA.Arena;
    block : Nat;
    caller : Principal;
    day : Nat;
    companyExists : Nat -> Bool;
    /// Is this an open journal of this company? Read from the ledger.
    journalOpen : (Nat, Nat) -> Bool;
    /// THE SALE, through the order fold: asked about whole, then placed, confirmed and invoiced.
    checkSale : (OF.OrderFacts, Nat) -> ?OFold.Refusal;
    placeOrder : OF.OrderFacts -> OFold.Outcome;
    confirmOrder : (Nat, Nat) -> OFold.Outcome;
    issueInvoice : (Nat, Nat, Nat) -> OFold.Outcome;
  };

  public type Outcome = { #ok : [Nat]; #err : Refusal };

  public let MAX_TAX_RATE : Nat = 10_000_000;
  /// A slice raises at most this many periods of one subscription; the rest wait for the next slice.
  public let MAX_PERIODS_PER_SLICE : Nat = 12;

  // ── helpers ─────────────────────────────────────────────────────────────────

  func one<T>(res : Page.Result<(Nat, T)>) : ?(Nat, T) {
    switch (res) {
      case (#err _) null;
      case (#ok p) { if (p.rows.size() == 0) null else ?p.rows[0] };
    }
  };

  func all<T>(store : RowStore.Store, decl : RowStore.Decl<T>, index : Text, lo : Blob, hi : Blob) : [(Nat, T)] {
    let out = List.empty<(Nat, T)>();
    var cursor : ?Page.Cursor = null;
    var more = true;
    while (more) {
      switch (RowStore.page<T>(store, decl, index, lo, hi, cursor, Page.MAX_LIMIT)) {
        case (#err _) { more := false };
        case (#ok pg) {
          for (row in pg.rows.vals()) List.add(out, row);
          switch (pg.next) { case null { more := false }; case (?k) { cursor := ?k } };
        };
      };
    };
    List.toArray(out)
  };

  func dayFits(day : Nat) : Bool { day < F.pow256(W.DAY) };

  public func periodText(p : E.SubscriptionPeriod) : Text { switch (p) { case (#monthly) "monthly"; case (#quarterly) "quarterly"; case (#yearly) "yearly" } };
  public func stateText(s : E.SubscriptionState) : Text { switch (s) { case (#active) "active"; case (#closed) "closed" } };
  public func kindText(k : E.SubscriptionInvoiceKind) : Text { switch (k) { case (#period) "period"; case (#proration) "proration" } };
  func runStateName(s : E.SubscriptionRunState) : Text { switch (s) { case (#running) "running"; case (#done) "done" } };

  func put(arena : TA.Arena, field : Text, t : Text) : { #ok : TA.Ref; #err : Refusal } {
    switch (TA.put(arena, t)) {
      case (#ok r) #ok(r);
      case (#err _) #err(#textDoesNotFit { field; value = t; max = TA.maxLength() });
    }
  };

  // ── the calendar ────────────────────────────────────────────────────────────

  /// THE FIRST DAY OF THE k-TH PERIOD: the start day's day of the month, k periods on by the civil
  /// calendar, clamped to the month's length.
  public func periodStart(startDay : Nat, period : E.SubscriptionPeriod, k : Nat) : Nat {
    let (y, m, d) = CivilDate.toCivil(startDay);
    let idx = m - 1 + k * E.subscriptionPeriodMonths(period);
    let y2 = y + idx / 12;
    let m2 = idx % 12 + 1;
    let last = CivilDate.daysInMonth(y2, m2);
    switch (CivilDate.fromCivil(y2, m2, if (d > last) last else d)) {
      case (?day) day;
      case null Runtime.trap("subscription: a period the calendar cannot place");
    }
  };

  /// THE PRORATION: the increase in a period's charge - (new quantity × new price − old quantity × old
  /// price), quantities in thousandths - times the days remaining over the days in the period, to the
  /// minor unit half to even. Zero when the charge does not rise.
  public func proration(oldQuantity : Nat, oldPrice : Nat, newQuantity : Nat, newPrice : Nat, remainingDays : Nat, periodDays : Nat) : Nat {
    let oldTotal = oldQuantity * oldPrice;
    let newTotal = newQuantity * newPrice;
    if (newTotal <= oldTotal or periodDays == 0) return 0;
    let exact = Dec.div(Dec.fromNat((newTotal - oldTotal) * remainingDays), Dec.fromNat(1_000 * periodDays), Dec.PREC);
    PE.quantiseWithResidue(exact, { code = "M"; minorUnits = 0 }).units
  };

  // ── reads ───────────────────────────────────────────────────────────────────

  public func openRunOf(st : Stores, companyId : Nat) : ?(Nat, SBR.SubscriptionRun) {
    let k = AR.closeOpenKey(companyId);
    one<SBR.SubscriptionRun>(RowStore.page<SBR.SubscriptionRun>(st.runs, SBR.subscriptionRun, "by_open", k, k, null, 1))
  };

  /// The head of the active subscriptions whose next period begins on or before `throughDay`.
  public func due(st : Stores, companyId : Nat, throughDay : Nat, limit : Nat) : [(Nat, SBR.Subscription)] {
    let (lo, hi) = SBR.dueRange(companyId, throughDay);
    switch (Lookup.upTo<SBR.Subscription>(st.subscriptions, SBR.subscription, "by_due", lo, hi, limit)) {
      case (#ok pg) pg.rows;
      case (#err _) [];
    }
  };

  public func invoicesOf(st : Stores, subscriptionId : Nat) : [(Nat, SBR.SubscriptionInvoice)] {
    let (lo, hi) = SBR.subscriptionRange(subscriptionId);
    all<SBR.SubscriptionInvoice>(st.invoices, SBR.subscriptionInvoice, "by_subscription", lo, hi)
  };

  func activeSubscription(c : Ctx, companyId : Nat, subscriptionId : Nat) : { #ok : SBR.Subscription; #err : Refusal } {
    let ?x = RowStore.get<SBR.Subscription>(c.sub.subscriptions, SBR.subscription, subscriptionId) else return #err(#noSuchSubscription { subscriptionId });
    if (x.companyId != companyId) return #err(#wrongCompany { expected = companyId; found = x.companyId });
    if (x.state != #active) return #err(#subscriptionClosed { subscriptionId });
    #ok(x)
  };

  /// The sale one period, or one proration, becomes.
  func saleOf(x : SBR.Subscription, companyId : Nat, day : Nat, currency : Text, name : Text, quantity : Nat, priceUnit : Nat, ref : Text) : OF.OrderFacts {
    { companyId; partnerId = x.partnerId; direction = #sale; orderDay = day; currency; clientRef = ref;
      lines = [{ categoryId = x.categoryId; name; quantity; priceUnit; taxRate = x.taxRate }] }
  };

  /// Place, confirm and invoice a sale already asked about; answer the order, the move, and the
  /// order's untaxed amount.
  func raise(c : Ctx, companyId : Nat, order : OF.OrderFacts, journalId : Nat) : { #ok : (Nat, Nat, Nat); #err : Refusal } {
    let orderId = switch (c.placeOrder(order)) { case (#err r) return #err(#order r); case (#ok ids) ids[0] };
    switch (c.confirmOrder(companyId, orderId)) { case (#err r) return #err(#order r); case (#ok _) {} };
    let invoiced = switch (c.issueInvoice(companyId, orderId, journalId)) { case (#err r) return #err(#order r); case (#ok ids) ids };
    let moveId = if (invoiced.size() > 1) invoiced[1] else 0;
    let amount = switch (RowStore.get<OR.Order>(c.ord.orders, OR.order, orderId)) { case (?o) o.amountUntaxed; case null 0 };
    #ok((orderId, moveId, amount))
  };

  // ── the subscription ────────────────────────────────────────────────────────

  public func openSubscription(c : Ctx, f : SB.SubscriptionFacts) : Outcome {
    if (not c.companyExists(f.companyId)) return #err(#wrongCompany { expected = f.companyId; found = 0 });
    let ?p = RowStore.get<OR.Partner>(c.ord.partners, OR.partner, f.partnerId) else return #err(#noSuchPartner { partnerId = f.partnerId });
    if (p.companyId != f.companyId) return #err(#wrongCompany { expected = f.companyId; found = p.companyId });
    if (not p.isCustomer) return #err(#partnerNotACustomer { partnerId = f.partnerId });
    let ?cat = RowStore.get<OR.Category>(c.ord.categories, OR.category, f.categoryId) else return #err(#noSuchCategory { categoryId = f.categoryId });
    if (cat.companyId != f.companyId) return #err(#wrongCompany { expected = f.companyId; found = cat.companyId });
    if (Text.size(f.name) == 0) return #err(#nameRequired { what = "subscription" });
    if (Text.size(f.name) > TA.maxLength()) return #err(#textDoesNotFit { field = "name"; value = f.name; max = TA.maxLength() });
    if (f.quantity == 0) return #err(#quantityZero);
    if (f.priceUnit == 0) return #err(#priceRequired);
    if (f.taxRate > MAX_TAX_RATE) return #err(#rateBound { what = "a tax rate"; value = f.taxRate; max = MAX_TAX_RATE });
    let ?currency = F.textField(f.currency, W.CURRENCY_CODE) else return #err(#codeDoesNotFit { code = f.currency; max = W.CURRENCY_CODE });
    if (Text.size(f.currency) == 0) return #err(#codeDoesNotFit { code = f.currency; max = W.CURRENCY_CODE });
    if (not dayFits(f.startDay)) return #err(#dayTooLarge { day = f.startDay });
    if (not dayFits(periodStart(f.startDay, f.period, 1))) return #err(#dayTooLarge { day = periodStart(f.startDay, f.period, 1) });
    let name = switch (put(c.arena, "name", f.name)) { case (#ok r) r; case (#err e) return #err(e) };
    let id = c.sub.nextSubscriptionId;
    RowStore.put<SBR.Subscription>(c.sub.subscriptions, SBR.subscription, id, {
      companyId = f.companyId; partnerId = f.partnerId; categoryId = f.categoryId; name; period = f.period; quantity = f.quantity; priceUnit = f.priceUnit; currency;
      taxRate = f.taxRate; startDay = f.startDay; state = #active; closedDay = 0; periodsInvoiced = 0; nextInvoiceDay = f.startDay; openedBy = c.caller; closedBy = c.caller; lastBlock = c.block });
    c.sub.nextSubscriptionId += 1;
    #ok([id])
  };

  /// Change what is sold and at what price, effective today. Inside a period already invoiced an
  /// increase is prorated over the remaining days and invoiced at once through the order fold;
  /// a decrease prices the next period and refunds nothing.
  public func changeSubscription(c : Ctx, f : SB.ChangeFacts) : Outcome {
    let x = switch (activeSubscription(c, f.companyId, f.subscriptionId)) { case (#err e) return #err(e); case (#ok x) x };
    if (f.quantity == 0) return #err(#quantityZero);
    if (f.priceUnit == 0) return #err(#priceRequired);
    if (f.quantity == x.quantity and f.priceUnit == x.priceUnit) return #err(#noChange { subscriptionId = f.subscriptionId });
    let ?currency = F.textOfField(x.currency) else return #err(#codeDoesNotFit { code = "?"; max = W.CURRENCY_CODE });
    // inside a period already invoiced?
    var prorated = 0;
    var periodFrom = 0;
    if (x.periodsInvoiced > 0 and c.day < x.nextInvoiceDay) {
      periodFrom := periodStart(x.startDay, x.period, x.periodsInvoiced - 1);
      prorated := proration(x.quantity, x.priceUnit, f.quantity, f.priceUnit, x.nextInvoiceDay - c.day, x.nextInvoiceDay - periodFrom);
    };
    var order : ?OF.OrderFacts = null;
    if (prorated > 0) {
      if (not c.journalOpen(f.companyId, f.journalId)) return #err(#noSuchJournal { journalId = f.journalId });
      let o = saleOf(x, f.companyId, c.day, currency, "proration of period " # Nat.toText(x.periodsInvoiced), 1_000, prorated, "subscription " # Nat.toText(f.subscriptionId) # " proration");
      switch (c.checkSale(o, f.journalId)) { case (?r) return #err(#order r); case null {} };
      order := ?o;
    };
    // nothing left that can refuse
    let ids = List.empty<Nat>();
    List.add(ids, f.subscriptionId);
    switch (order) {
      case (?o) {
        let (orderId, moveId, amount) = switch (raise(c, f.companyId, o, f.journalId)) { case (#err e) return #err(e); case (#ok t) t };
        let iid = c.sub.nextInvoiceId;
        RowStore.put<SBR.SubscriptionInvoice>(c.sub.invoices, SBR.subscriptionInvoice, iid, {
          companyId = f.companyId; subscriptionId = f.subscriptionId; ordinal = x.periodsInvoiced; kind = #proration; fromDay = c.day; toDay = x.nextInvoiceDay;
          quantity = f.quantity; priceUnit = f.priceUnit; amount; orderId; moveId; lastBlock = c.block });
        c.sub.nextInvoiceId += 1;
        List.add(ids, iid); List.add(ids, orderId); List.add(ids, moveId);
      };
      case null {};
    };
    RowStore.put<SBR.Subscription>(c.sub.subscriptions, SBR.subscription, f.subscriptionId, { x with quantity = f.quantity; priceUnit = f.priceUnit; lastBlock = c.block });
    #ok(List.toArray(ids))
  };

  /// Close a subscription: invoiced no more; the period already invoiced is not refunded.
  public func closeSubscription(c : Ctx, companyId : Nat, subscriptionId : Nat) : Outcome {
    let x = switch (activeSubscription(c, companyId, subscriptionId)) { case (#err e) return #err(e); case (#ok x) x };
    RowStore.put<SBR.Subscription>(c.sub.subscriptions, SBR.subscription, subscriptionId, { x with state = #closed; closedDay = c.day; closedBy = c.caller; lastBlock = c.block });
    #ok([subscriptionId])
  };

  // ── the run ─────────────────────────────────────────────────────────────────

  public func openRun(c : Ctx, companyId : Nat, throughDay : Nat, journalId : Nat) : Outcome {
    if (not c.companyExists(companyId)) return #err(#wrongCompany { expected = companyId; found = 0 });
    if (not dayFits(throughDay)) return #err(#dayTooLarge { day = throughDay });
    if (throughDay > c.day) return #err(#horizonNotReached { throughDay; day = c.day });
    if (not c.journalOpen(companyId, journalId)) return #err(#noSuchJournal { journalId });
    switch (openRunOf(c.sub, companyId)) { case (?(runId, _)) return #err(#subscriptionRunOpen { companyId; runId }); case null {} };
    let id = c.sub.nextRunId;
    RowStore.put<SBR.SubscriptionRun>(c.sub.runs, SBR.subscriptionRun, id, { companyId; throughDay; journalId; state = #running; invoicesIssued = 0; openedBy = c.caller; lastBlock = c.block });
    c.sub.nextRunId += 1;
    #ok([id])
  };

  /// One slice, by somebody other than the opener: the head of the active subscriptions whose next
  /// period begins by the run's day, up to `limit`; for each, one sale per period begun, at most
  /// `MAX_PERIODS_PER_SLICE` of them. Every sale asked about whole before any is raised; a customer past
  /// their limit refuses the slice whole. The run closes when nothing is left due.
  public func runSlice(c : Ctx, companyId : Nat, runId : Nat, limit : Nat) : Outcome {
    if (limit == 0 or limit > Page.MAX_LIMIT) return #err(#sliceBound { limit; max = Page.MAX_LIMIT });
    let ?run = RowStore.get<SBR.SubscriptionRun>(c.sub.runs, SBR.subscriptionRun, runId) else return #err(#noSuchSubscriptionRun { runId });
    if (run.companyId != companyId) return #err(#wrongCompany { expected = companyId; found = run.companyId });
    if (run.state != #running) return #err(#runNotInState { runId; state = runStateName(run.state); wanted = "running" });
    if (c.caller == run.openedBy) return #err(#selfInvoicing { opener = run.openedBy });
    let page = due(c.sub, companyId, run.throughDay, limit);
    // ── every sale the slice will raise, asked about, before any is ──
    let prepared = List.empty<(Nat, Nat, Nat, Nat, OF.OrderFacts)>();   // subscription, ordinal (k + 1), from, to, the sale
    var caughtUp = true;
    for ((sid, x) in page.vals()) {
      let ?currency = F.textOfField(x.currency) else return #err(#codeDoesNotFit { code = "?"; max = W.CURRENCY_CODE });
      var k = x.periodsInvoiced;
      var n = 0;
      while (periodStart(x.startDay, x.period, k) <= run.throughDay and n < MAX_PERIODS_PER_SLICE) {
        let from = periodStart(x.startDay, x.period, k);
        let to = periodStart(x.startDay, x.period, k + 1);
        if (not dayFits(to)) return #err(#dayTooLarge { day = to });
        let o = saleOf(x, companyId, c.day, currency, "period " # Nat.toText(k + 1), x.quantity, x.priceUnit, "subscription " # Nat.toText(sid) # " period " # Nat.toText(k + 1));
        switch (c.checkSale(o, run.journalId)) { case (?r) return #err(#order r); case null {} };
        List.add(prepared, (sid, k + 1, from, to, o));
        k += 1;
        n += 1;
      };
      if (periodStart(x.startDay, x.period, k) <= run.throughDay) caughtUp := false;
    };
    // ── the writes ──
    let ids = List.empty<Nat>();
    List.add(ids, runId);
    var issued = run.invoicesIssued;
    for ((sid, ordinal, from, to, o) in List.values(prepared)) {
      let (orderId, moveId, amount) = switch (raise(c, companyId, o, run.journalId)) { case (#err e) return #err(e); case (#ok t) t };
      let iid = c.sub.nextInvoiceId;
      RowStore.put<SBR.SubscriptionInvoice>(c.sub.invoices, SBR.subscriptionInvoice, iid, {
        companyId; subscriptionId = sid; ordinal; kind = #period; fromDay = from; toDay = to; quantity = o.lines[0].quantity; priceUnit = o.lines[0].priceUnit; amount; orderId; moveId; lastBlock = c.block });
      c.sub.nextInvoiceId += 1;
      // the subscription is re-read: one subscription may have several periods in this slice
      let ?x = RowStore.get<SBR.Subscription>(c.sub.subscriptions, SBR.subscription, sid) else return #err(#noSuchSubscription { subscriptionId = sid });
      RowStore.put<SBR.Subscription>(c.sub.subscriptions, SBR.subscription, sid, { x with periodsInvoiced = ordinal; nextInvoiceDay = to; lastBlock = c.block });
      issued += 1;
      List.add(ids, iid);
    };
    let lastPage = page.size() < limit and caughtUp;
    RowStore.put<SBR.SubscriptionRun>(c.sub.runs, SBR.subscriptionRun, runId, { run with state = if (lastPage) #done else #running; invoicesIssued = issued; lastBlock = c.block });
    #ok(List.toArray(ids))
  };

}
