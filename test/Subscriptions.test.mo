// Subscriptions.test.mo - a recurring order with a period, invoices generated by a bounded run on the
// calendar, proration on change, and a subscription closed by its customer.
//
// What it proves, each against the battery's OWN restatement of the rule:
//
//   the subscription  to a customer - not a supplier, not another company's partner - of a category
//                     of the company, so much at a price in a currency at a tax rate, from a start day;
//                     nothing, no price, a tax beyond sense, a currency that is not one: refused.
//   the calendar      the k-th period begins on the start day's day of the month, k periods on by the
//                     civil calendar, clamped to the month - the battery names the dates: a subscription
//                     from the 31st of January renews on the 28th of February and the 31st of March.
//   the run           opened by one person through a day that has come in an open journal, sliced by
//                     another; every period begun by the run's day invoiced as a sale through the order
//                     fold, dated the run's day, at most twelve periods of one subscription a slice - 
//                     twenty periods behind are caught up in two slices and the run closes on the
//                     second; a customer past their limit refuses the slice WHOLE with nothing written,
//                     and closing their subscription lets the run go on; the invoices' totals are the
//                     battery's own arithmetic.
//   the proration     a rise inside an invoiced period is the difference in the period's charge times
//                     the days remaining over the days in the period, to the minor unit half to even,
//                     invoiced at once; a fall invoices nothing and prices the next period; a change
//                     outside an invoiced period invoices nothing.
//   closed            a closed subscription is invoiced no more, changed no more, closed no more.
//   the fold          the log replayed from genesis reproduces every table; a count flipped without
//                     a block is a different fingerprint.
//
// engine: wasi-only - a Region is stable memory, which the interpreter does not provide.

import Array "mo:core/Array";
import Blob "mo:core/Blob";
import Debug "mo:core/Debug";
import Nat "mo:core/Nat";
import Nat8 "mo:core/Nat8";
import Nat64 "mo:core/Nat64";
import Principal "mo:core/Principal";
import Runtime "mo:core/Runtime";

import CivilDate "mo:kernel/num/CivilDate";
import DL "mo:kernel/domain/DomainLog";
import Fold "mo:kernel/domain/Fold";
import Page "mo:kernel/rows/Page";
import RowStore "mo:kernel/rows/RowStore";

import AFacts "../src/AcctFacts";
import Clk "../src/ClockWiring";
import Cmd "../src/Command";
import Con "../src/Contract";
import E "../src/Enums";
import Log "../src/Log";
import OFold "../src/OrderFold";
import OR "../src/OrderRows";
import SB "../src/SubFacts";
import SFold "../src/SubFold";
import SR "../src/SubRows";
import St "../src/State";

var failures = 0;
func check(cond : Bool, what : Text) { if (not cond) { failures += 1; Debug.print("FAIL: " # what) } };
let NONE : Nat -> ?Blob = func(_ : Nat) : ?Blob { null };

func who(n : Nat) : Principal {
  Principal.fromBlob(Blob.fromArray(Array.tabulate<Nat8>(29, func(i) {
    if (i == 0) 1 else if (i == 1) Nat8.fromNat(n / 256) else if (i == 2) Nat8.fromNat(n % 256) else 0
  })))
};
let BOSS = who(1);     // sets up the company
let OPENER = who(2);   // opens runs and subscriptions
let SLICER = who(3);   // slices the runs
let CLOSER = who(4);   // closes a subscription
let STRANGER = who(9);

var heightCell : Nat = 101_000;
let source : Clk.Source = {
  substrateNow = func() : Nat64 { Nat64.fromNat(heightCell) };
  substrateHeight = func() : Nat { heightCell };
  blockTimestamp = func() : ?Nat64 { null };
};
/// 2026-09-13 by the civil calendar.
let DAY : Nat = 20_709;
var config = switch (Clk.roll(Clk.genesisConfig(400_000), DAY)) {
  case (#ok c) c;
  case (#err e) Runtime.trap("could not roll the business date: " # Clk.errorText(e));
};
func roll(to : Nat) {
  config := switch (Clk.roll(config, to)) {
    case (#ok c) c;
    case (#err e) Runtime.trap("could not roll the calendar: " # Clk.errorText(e));
  };
};
/// The battery's own calendar: a civil date as a day number.
func date(y : Nat, m : Nat, d : Nat) : Nat { switch (CivilDate.fromCivil(y, m, d)) { case (?x) x; case null Runtime.trap("not a date") } };
check(date(2026, 9, 13) == DAY, "DAY is the 13th of September 2026");

let log = Log.newState();
let state = St.newState();

func send(caller : Principal, c : Cmd.Command) : { #ok : Con.Accepted; #err : Con.Refused } {
  heightCell += 1;
  Con.accept(log, state, config, source, caller, c)
};
func mustOk(caller : Principal, c : Cmd.Command, what : Text) : [Nat] {
  switch (send(caller, c)) {
    case (#ok a) a.effects;
    case (#err r) { check(false, what # ": " # Con.refusedText(r)); [] };
  }
};
var refusals = 0;
func mustFail(caller : Principal, c : Cmd.Command, what : Text) {
  switch (send(caller, c)) {
    case (#ok _) { check(false, "expected a refusal: " # what) };
    case (#err _) { refusals += 1 };
  }
};
func mustFailUntouched(caller : Principal, c : Cmd.Command, what : Text) {
  let before = St.fingerprintHash(state);
  mustFail(caller, c, what);
  check(St.fingerprintHash(state) == before, what # ": refused with nothing written");
};

// ── the company: chart, customers, category ───────────────────────────────────

let CO = mustOk(BOSS, #bootstrapCompany { facts = { name = "Software as a Service"; slug = "saas"; orgCode = ""; geoLat = null; geoLon = null; geoRadiusMetres = 0; geoRequireLocation = false } }, "the company")[0];
for (p in [OPENER, SLICER, CLOSER].vals()) { ignore mustOk(BOSS, #admitMember { companyId = CO; subject = p; companyRole = #Director; platformRole = #None; managerId = 0 }, "a director") };
let OTHER = mustOk(BOSS, #bootstrapCompany { facts = { name = "Another"; slug = "another"; orgCode = ""; geoLat = null; geoLon = null; geoRadiusMetres = 0; geoRequireLocation = false } }, "another company")[0];
func acct(co : Nat, code : Text, name : Text, t : E.AccountType) : AFacts.AccountFacts =
  { companyId = co; code; name; accountType = t; parentId = 0; reconcilable = false; currency = "EGP" };
let RECV = mustOk(BOSS, #createAccount { facts = acct(CO, "1200", "Receivable", #receivable) }, "receivable")[0];
let SALES = mustOk(BOSS, #createAccount { facts = acct(CO, "4000", "Subscription revenue", #income) }, "revenue")[0];
let COGS = mustOk(BOSS, #createAccount { facts = acct(CO, "5000", "Cost", #expense) }, "cost")[0];
let VAT = mustOk(BOSS, #createAccount { facts = acct(CO, "2300", "VAT", #liability) }, "vat")[0];
let LATE = mustOk(BOSS, #createAccount { facts = acct(CO, "4900", "Late charges", #income) }, "late charges")[0];
let J = mustOk(BOSS, #createJournal { facts = { companyId = CO; code = "SAL"; name = "Sales"; journalType = #general; defaultAccountId = 0 } }, "the journal")[0];
let OTHER_RECV = mustOk(BOSS, #createAccount { facts = acct(OTHER, "1200", "Receivable", #receivable) }, "their receivable")[0];
let OTHER_J = mustOk(BOSS, #createJournal { facts = { companyId = OTHER; code = "GEN"; name = "General"; journalType = #general; defaultAccountId = 0 } }, "their journal")[0];
func partner(co : Nat, code : Text, name : Text, customer : Bool, recv : Nat) : Nat =
  mustOk(BOSS, #createPartner { facts = { companyId = co; code; name; isCustomer = customer; isSupplier = not customer; receivableAccountId = recv; payableAccountId = if (customer) 0 else VAT; taxIdentifier = "" } }, name)[0];
let CUST = partner(CO, "C-1", "A customer", true, RECV);
let CUST2 = partner(CO, "C-2", "A customer on a short leash", true, RECV);
let SUPP = partner(CO, "S-1", "A supplier", false, 0);
let OTHER_CUST = partner(OTHER, "C-1", "Their customer", true, OTHER_RECV);
ignore mustOk(BOSS, #setCreditTerms { facts = { companyId = CO; partnerId = CUST2; limit = 50_000; termDays = 30; graceDays = 0; lateCharge = 0; interestRate = 0; incomeAccountId = LATE; journalId = J } }, "a limit of 500.00");
let SAAS = mustOk(BOSS, #createCategory { facts = { companyId = CO; code = "SAAS"; name = "The service"; incomeAccountId = SALES; expenseAccountId = COGS } }, "the category")[0];
let OTHER_SALES = mustOk(BOSS, #createAccount { facts = acct(OTHER, "4000", "Sales", #income) }, "their sales")[0];
let OTHER_COST = mustOk(BOSS, #createAccount { facts = acct(OTHER, "5000", "Cost", #expense) }, "their cost")[0];
let OTHER_CAT = mustOk(BOSS, #createCategory { facts = { companyId = OTHER; code = "X"; name = "Theirs"; incomeAccountId = OTHER_SALES; expenseAccountId = OTHER_COST } }, "their category")[0];

// ── reads ─────────────────────────────────────────────────────────────────────

func sub(id : Nat) : SR.Subscription { switch (RowStore.get<SR.Subscription>(state.sub.subscriptions, SR.subscription, id)) { case (?x) x; case null Runtime.trap("no subscription " # Nat.toText(id)) } };
func run(id : Nat) : SR.SubscriptionRun { switch (RowStore.get<SR.SubscriptionRun>(state.sub.runs, SR.subscriptionRun, id)) { case (?x) x; case null Runtime.trap("no run " # Nat.toText(id)) } };
func order(id : Nat) : OR.Order { switch (RowStore.get<OR.Order>(state.ord.orders, OR.order, id)) { case (?o) o; case null Runtime.trap("no order " # Nat.toText(id)) } };
func invoices() : Nat { RowStore.size(state.sub.invoices) };
func orders() : Nat { RowStore.size(state.ord.orders) };

// ── the calendar, by the battery's own dates ──────────────────────────────────

let JAN31 = date(2026, 1, 31);
check(SFold.periodStart(JAN31, #monthly, 0) == JAN31, "period 0 begins on the start day");
check(SFold.periodStart(JAN31, #monthly, 1) == date(2026, 2, 28), "FROM THE 31ST OF JANUARY, THE NEXT PERIOD BEGINS ON THE 28TH OF FEBRUARY");
check(SFold.periodStart(JAN31, #monthly, 2) == date(2026, 3, 31), "and the one after on the 31st of March - the day of the month comes back");
check(SFold.periodStart(JAN31, #monthly, 3) == date(2026, 4, 30), "then the 30th of April");
check(SFold.periodStart(JAN31, #quarterly, 1) == date(2026, 4, 30) and SFold.periodStart(JAN31, #quarterly, 4) == date(2027, 1, 31), "quarters: the 30th of April; four quarters on, the 31st of January next year");
check(SFold.periodStart(JAN31, #yearly, 1) == date(2027, 1, 31) and SFold.periodStart(date(2028, 2, 29), #yearly, 1) == date(2029, 2, 28), "years: the same date; a leap day renews on the 28th");
check(SFold.periodStart(date(2026, 11, 15), #monthly, 2) == date(2027, 1, 15), "a monthly period over the year's end");

// ── the subscriptions ─────────────────────────────────────────────────────────

func sf(co : Nat, partnerId : Nat, categoryId : Nat, period : E.SubscriptionPeriod, quantity : Nat, price : Nat, start : Nat) : SB.SubscriptionFacts =
  { companyId = co; partnerId; categoryId; name = "The service"; period; quantity; priceUnit = price; currency = "EGP"; taxRate = 140_000; startDay = start };
mustFailUntouched(OPENER, #openSubscription { facts = sf(9_999, CUST, SAAS, #monthly, 1_000, 100_000, DAY) }, "a subscription of a company that does not exist");
mustFailUntouched(OPENER, #openSubscription { facts = sf(CO, 9_999, SAAS, #monthly, 1_000, 100_000, DAY) }, "a subscription for a partner that does not exist");
mustFailUntouched(OPENER, #openSubscription { facts = sf(CO, OTHER_CUST, SAAS, #monthly, 1_000, 100_000, DAY) }, "a subscription for another company's customer");
mustFailUntouched(OPENER, #openSubscription { facts = sf(CO, SUPP, SAAS, #monthly, 1_000, 100_000, DAY) }, "A SUBSCRIPTION SOLD TO A SUPPLIER");
mustFailUntouched(OPENER, #openSubscription { facts = sf(CO, CUST, 9_999, #monthly, 1_000, 100_000, DAY) }, "a subscription of a category that does not exist");
mustFailUntouched(OPENER, #openSubscription { facts = sf(CO, CUST, OTHER_CAT, #monthly, 1_000, 100_000, DAY) }, "a subscription of another company's category");
mustFailUntouched(OPENER, #openSubscription { facts = { sf(CO, CUST, SAAS, #monthly, 1_000, 100_000, DAY) with name = "" } }, "a subscription without a name");
mustFailUntouched(OPENER, #openSubscription { facts = sf(CO, CUST, SAAS, #monthly, 0, 100_000, DAY) }, "a subscription of nothing");
mustFailUntouched(OPENER, #openSubscription { facts = sf(CO, CUST, SAAS, #monthly, 1_000, 0, DAY) }, "a subscription at no price");
mustFailUntouched(OPENER, #openSubscription { facts = { sf(CO, CUST, SAAS, #monthly, 1_000, 100_000, DAY) with taxRate = SFold.MAX_TAX_RATE + 1 } }, "a tax beyond sense");
mustFailUntouched(OPENER, #openSubscription { facts = { sf(CO, CUST, SAAS, #monthly, 1_000, 100_000, DAY) with currency = "" } }, "a subscription in no currency");
mustFailUntouched(OPENER, #openSubscription { facts = { sf(CO, CUST, SAAS, #monthly, 1_000, 100_000, DAY) with currency = "POUNDS" } }, "a currency that does not fit");
mustFailUntouched(OPENER, #openSubscription { facts = sf(CO, CUST, SAAS, #monthly, 1_000, 100_000, 16_777_216) }, "a start day that does not fit");
// S1: 1.000 of the service at 1,000.00 a month since the 30th of July
let S1 = mustOk(OPENER, #openSubscription { facts = sf(CO, CUST, SAAS, #monthly, 1_000, 100_000, date(2026, 7, 30)) }, "S1")[0];
check(sub(S1).state == #active and sub(S1).periodsInvoiced == 0 and sub(S1).nextInvoiceDay == date(2026, 7, 30) and sub(S1).openedBy == OPENER, "S1 stands, its first period due on its start day");
// S2: since the 31st of January - the clamped months
let S2 = mustOk(OPENER, #openSubscription { facts = sf(CO, CUST, SAAS, #monthly, 2_000, 50_000, JAN31) }, "S2")[0];
// S3: twenty months behind
let S3 = mustOk(OPENER, #openSubscription { facts = sf(CO, CUST, SAAS, #monthly, 1_000, 10_000, date(2025, 1, 15)) }, "S3")[0];
// S4: quarterly, not yet begun
let S4 = mustOk(OPENER, #openSubscription { facts = sf(CO, CUST, SAAS, #quarterly, 1_000, 300_000, DAY + 10) }, "S4")[0];
// S5: for the customer on a short leash, more than their limit
let S5 = mustOk(OPENER, #openSubscription { facts = sf(CO, CUST2, SAAS, #monthly, 1_000, 100_000, DAY - 10) }, "S5")[0];

// ── the run ───────────────────────────────────────────────────────────────────

mustFailUntouched(OPENER, #openSubscriptionRun { companyId = 9_999; throughDay = DAY; journalId = J }, "a run of a company that does not exist");
mustFailUntouched(OPENER, #openSubscriptionRun { companyId = CO; throughDay = 16_777_216; journalId = J }, "a run through a day that does not fit");
mustFailUntouched(OPENER, #openSubscriptionRun { companyId = CO; throughDay = DAY + 1; journalId = J }, "A RUN THROUGH A DAY THAT HAS NOT COME");
mustFailUntouched(OPENER, #openSubscriptionRun { companyId = CO; throughDay = DAY; journalId = 9_999 }, "a run in a journal that does not exist");
mustFailUntouched(OPENER, #openSubscriptionRun { companyId = CO; throughDay = DAY; journalId = OTHER_J }, "a run in another company's journal");
let R1 = mustOk(OPENER, #openSubscriptionRun { companyId = CO; throughDay = DAY; journalId = J }, "the run through today")[0];
mustFailUntouched(OPENER, #openSubscriptionRun { companyId = CO; throughDay = DAY; journalId = J }, "a second run while one is open");
mustFailUntouched(SLICER, #subscriptionRunSlice { companyId = CO; runId = 9_999; limit = 10 }, "a slice of a run that does not exist");
mustFailUntouched(SLICER, #subscriptionRunSlice { companyId = OTHER; runId = R1; limit = 10 }, "a slice under the wrong company");
// THE CUSTOMER ON A SHORT LEASH: the slice refuses whole, with nothing written, not even the others
mustFailUntouched(SLICER, #subscriptionRunSlice { companyId = CO; runId = R1; limit = 10 }, "A CUSTOMER PAST THEIR LIMIT REFUSES THE SLICE WHOLE");
check(orders() == 0 and invoices() == 0 and sub(S1).periodsInvoiced == 0, "nothing was invoiced, not even the others");
ignore mustOk(CLOSER, #closeSubscription { companyId = CO; subscriptionId = S5; reason = "over the limit" }, "their subscription closed");
check(sub(S5).state == #closed and sub(S5).closedBy == CLOSER and sub(S5).closedDay == DAY, "closed by the closer today");
// with nothing else in the way: the bounds of a slice and the opener's hand
mustFailUntouched(SLICER, #subscriptionRunSlice { companyId = CO; runId = R1; limit = 0 }, "a slice of nothing");
mustFailUntouched(SLICER, #subscriptionRunSlice { companyId = CO; runId = R1; limit = Page.MAX_LIMIT + 1 }, "a slice beyond the page");
mustFailUntouched(OPENER, #subscriptionRunSlice { companyId = CO; runId = R1; limit = 10 }, "THE OPENER SLICING THEIR OWN RUN");
// the first slice: S3 is twenty periods behind and gets twelve; S1 two; S2 eight; the run stays open
let slice1 = mustOk(SLICER, #subscriptionRunSlice { companyId = CO; runId = R1; limit = 10 }, "the first slice");
check(slice1.size() == 1 + 12 + 2 + 8, "TWENTY-TWO INVOICES: twelve of S3, two of S1, eight of S2 - got " # Nat.toText(slice1.size() - 1));
check(run(R1).state == #running and run(R1).invoicesIssued == 22, "THE RUN STAYS OPEN: S3 is not caught up");
check(sub(S1).periodsInvoiced == 2 and sub(S1).nextInvoiceDay == date(2026, 9, 30), "S1: July and August invoiced, September next");
check(sub(S2).periodsInvoiced == 8 and sub(S2).nextInvoiceDay == date(2026, 9, 30), "S2: eight periods from the 31st of January, the 30th of September next");
check(sub(S3).periodsInvoiced == 12 and sub(S3).nextInvoiceDay == date(2026, 1, 15), "S3: twelve periods, the 15th of January 2026 next");
check(sub(S4).periodsInvoiced == 0 and sub(S5).periodsInvoiced == 0, "the one not begun and the one closed: nothing");
let slice2 = mustOk(SLICER, #subscriptionRunSlice { companyId = CO; runId = R1; limit = 10 }, "the second slice");
check(slice2.size() == 1 + 8 and run(R1).state == #done and run(R1).invoicesIssued == 30, "EIGHT MORE AND THE RUN IS DONE: thirty invoices");
check(sub(S3).periodsInvoiced == 20 and sub(S3).nextInvoiceDay == date(2026, 9, 15), "S3 caught up: the 15th of September next, two days from now");
mustFailUntouched(SLICER, #subscriptionRunSlice { companyId = CO; runId = R1; limit = 10 }, "slicing a run that is done");
// the invoices: the battery's own arithmetic. S1: 1.000 × 1,000.00 = 1,000.00 untaxed, 140.00 tax; S2: 2.000 × 500.00 = 1,000.00
do {
  let s1Invoices = SFold.invoicesOf(state.sub, S1);
  check(s1Invoices.size() == 2 and s1Invoices[0].1.kind == #period and s1Invoices[0].1.ordinal == 1 and s1Invoices[0].1.fromDay == date(2026, 7, 30) and s1Invoices[0].1.toDay == date(2026, 8, 30), "S1's first invoice covers the 30th of July to the 30th of August");
  check(s1Invoices[1].1.ordinal == 2 and s1Invoices[1].1.fromDay == date(2026, 8, 30) and s1Invoices[1].1.toDay == date(2026, 9, 30) and s1Invoices[1].1.amount == 100_000, "the second the 30th of August to the 30th of September, 1,000.00");
  let o = order(s1Invoices[0].1.orderId);
  check(o.state == #invoiced and o.partnerId == CUST and o.direction == #sale and o.amountUntaxed == 100_000 and o.amountTax == 14_000 and o.orderDay == DAY, "AN ORDER LIKE ANY OTHER: a sale to the customer, 1,000.00 plus 14 per cent, dated the run's day");
  check(o.invoiceMoveId == s1Invoices[0].1.moveId and o.invoiceMoveId != 0, "invoiced through the ledger");
  let s2Invoices = SFold.invoicesOf(state.sub, S2);
  check(s2Invoices[1].1.fromDay == date(2026, 2, 28) and s2Invoices[1].1.toDay == date(2026, 3, 31) and s2Invoices[1].1.amount == 100_000, "S2's second period: the 28th of February to the 31st of March");
  check(orders() == 30 and invoices() == 30, "thirty orders, thirty invoice rows");
};

// ── proration on change ───────────────────────────────────────────────────────

func cf(subscriptionId : Nat, quantity : Nat, price : Nat) : SB.ChangeFacts = { companyId = CO; subscriptionId; quantity; priceUnit = price; journalId = J };
mustFailUntouched(OPENER, #changeSubscription { facts = cf(9_999, 1_000, 130_000) }, "changing a subscription that does not exist");
mustFailUntouched(OPENER, #changeSubscription { facts = { cf(S1, 1_000, 130_000) with companyId = OTHER } }, "changing under the wrong company");
mustFailUntouched(OPENER, #changeSubscription { facts = cf(S1, 0, 130_000) }, "a change to nothing");
mustFailUntouched(OPENER, #changeSubscription { facts = cf(S1, 1_000, 0) }, "a change to no price");
mustFailUntouched(OPENER, #changeSubscription { facts = cf(S1, 1_000, 100_000) }, "A CHANGE THAT CHANGES NOTHING");
mustFailUntouched(OPENER, #changeSubscription { facts = cf(S5, 1_000, 130_000) }, "changing a closed subscription");
mustFailUntouched(OPENER, #changeSubscription { facts = { cf(S1, 1_000, 130_000) with journalId = 9_999 } }, "a rise in a journal that is not there: the proration cannot be invoiced");
// S1's current period: the 30th of August to the 30th of September, 31 days; today is the 13th: 17 remain.
// The charge rises from 1,000.00 to 1,300.00: 300.00 × 17 / 31 = 164.516… → 164.52
check(SFold.proration(1_000, 100_000, 1_000, 130_000, 17, 31) == 16_452, "THE PRORATION: 300.00 × 17 / 31 = 164.52");
check(SFold.proration(1_000, 100_000, 2_000, 100_000, 17, 31) == 54_839, "doubling the quantity: 1,000.00 × 17 / 31 = 548.39");
check(SFold.proration(1_000, 100_000, 1_000, 90_000, 17, 31) == 0 and SFold.proration(1_000, 100_000, 1_000, 100_000, 17, 31) == 0, "a fall, or no change, prorates nothing");
check(SFold.proration(1_000, 100_000, 1_000, 100_001, 1, 31) == 0 and SFold.proration(1_000, 100_000, 1_000, 100_031, 1, 31) == 1, "to the minor unit half to even: 0.01 × 1/31 rounds to nothing, 0.31 × 1/31 to one");
let ordersBefore = orders();
let rise = mustOk(OPENER, #changeSubscription { facts = cf(S1, 1_000, 130_000) }, "S1 rises to 1,300.00 a month");
check(rise.size() == 4 and rise[0] == S1, "the subscription, the proration invoice, the order and the move");
do {
  let inv = SFold.invoicesOf(state.sub, S1);
  check(inv.size() == 3 and inv[2].1.kind == #proration and inv[2].1.ordinal == 2 and inv[2].1.fromDay == DAY and inv[2].1.toDay == date(2026, 9, 30), "A PRORATION INVOICE for the rest of period 2, from today");
  check(inv[2].1.amount == 16_452 and inv[2].1.quantity == 1_000 and inv[2].1.priceUnit == 130_000, "164.52, at the new price");
  let o = order(inv[2].1.orderId);
  check(o.amountUntaxed == 16_452 and o.amountTax == 2_303 and o.state == #invoiced, "the order carries 164.52 and 14 per cent of it, 23.03");
  check(sub(S1).priceUnit == 130_000 and sub(S1).periodsInvoiced == 2 and orders() == ordersBefore + 1, "the price stands at 1,300.00; the periods invoiced are unchanged");
};
let fall = mustOk(OPENER, #changeSubscription { facts = cf(S1, 1_000, 90_000) }, "S1 falls to 900.00 a month");
check(fall == [S1] and orders() == ordersBefore + 1 and sub(S1).priceUnit == 90_000, "A FALL INVOICES NOTHING and prices the next period");
ignore mustOk(OPENER, #changeSubscription { facts = cf(S4, 2_000, 300_000) }, "S4 doubled before it began");
check(orders() == ordersBefore + 1 and sub(S4).quantity == 2_000, "a change before any invoice prorates nothing");
// a subscription the run has not reached: the change prices the pending period, no proration
let S6 = mustOk(OPENER, #openSubscription { facts = sf(CO, CUST, SAAS, #monthly, 1_000, 100_000, DAY - 5) }, "S6, begun five days ago, not yet invoiced")[0];
ignore mustOk(OPENER, #changeSubscription { facts = cf(S6, 1_000, 200_000) }, "S6 doubled before its first invoice");
check(orders() == ordersBefore + 1, "no proration: the run has not reached it");
let R2 = mustOk(OPENER, #openSubscriptionRun { companyId = CO; throughDay = DAY; journalId = J }, "a second run through today")[0];
let slice3 = mustOk(SLICER, #subscriptionRunSlice { companyId = CO; runId = R2; limit = 100 }, "sliced");
check(slice3.size() == 2 and run(R2).state == #done, "ONE INVOICE: S6's first period, at the new price; everybody else is invoiced through today");
check(SFold.invoicesOf(state.sub, S6)[0].1.amount == 200_000 and SFold.invoicesOf(state.sub, S6)[0].1.priceUnit == 200_000, "S6's first period at 2,000.00");

// ── closed ────────────────────────────────────────────────────────────────────

mustFailUntouched(CLOSER, #closeSubscription { companyId = CO; subscriptionId = 9_999; reason = "" }, "closing a subscription that does not exist");
mustFailUntouched(CLOSER, #closeSubscription { companyId = OTHER; subscriptionId = S1; reason = "" }, "closing under the wrong company");
mustFailUntouched(CLOSER, #closeSubscription { companyId = CO; subscriptionId = S5; reason = "" }, "closing twice");
ignore mustOk(CLOSER, #closeSubscription { companyId = CO; subscriptionId = S1; reason = "the customer left" }, "S1 CLOSED BY ITS CUSTOMER'S SIDE");
roll(date(2026, 10, 3));
let R3 = mustOk(OPENER, #openSubscriptionRun { companyId = CO; throughDay = date(2026, 10, 3); journalId = J }, "a run into October")[0];
let slice4 = mustOk(SLICER, #subscriptionRunSlice { companyId = CO; runId = R3; limit = 100 }, "sliced");
// due by the 3rd of October: S2 (the 30th of September), S3 (the 15th of September), S4 (the 23rd of September), S6 (the 8th of October? no - the 13th of September + a month is the 8th of October: not due)
check(slice4.size() == 4 and run(R3).state == #done, "THREE INVOICES: S2, S3 and S4 - S1 is closed and S6 is not yet due; got " # Nat.toText(slice4.size() - 1));
check(sub(S1).periodsInvoiced == 2 and SFold.invoicesOf(state.sub, S1).size() == 3, "A CLOSED SUBSCRIPTION IS INVOICED NO MORE");
check(SFold.invoicesOf(state.sub, S4)[0].1.amount == 600_000 and SFold.invoicesOf(state.sub, S4)[0].1.toDay == SFold.periodStart(DAY + 10, #quarterly, 1), "S4's first quarter at the doubled quantity: 2.000 × 3,000.00");

// ── the fold ──────────────────────────────────────────────────────────────────

let replay = Con.newReplay();
ignore Fold.replay<Log.Event, Con.Replay>(log, Log.codec, NONE, replay, Con.replayBlock);
check(St.fingerprintHash(replay.state) == St.fingerprintHash(state), "the log replayed from genesis reproduces the live state, the subscriptions, their invoices and the runs included");
check(RowStore.size(replay.state.sub.invoices) == invoices() and RowStore.size(replay.state.ord.orders) == orders(), "every table is reproduced");
do {
  let before = St.fingerprintHash(state);
  let x = sub(S2);
  RowStore.put<SR.Subscription>(state.sub.subscriptions, SR.subscription, S2, { x with periodsInvoiced = x.periodsInvoiced + 1 });
  check(St.fingerprintHash(state) != before, "a period counted without a block is a different fingerprint");
  RowStore.put<SR.Subscription>(state.sub.subscriptions, SR.subscription, S2, x);
  check(St.fingerprintHash(state) == before, "restored, the fingerprint is what it was");
  let (iid, inv) = SFold.invoicesOf(state.sub, S1)[2];
  RowStore.put<SR.SubscriptionInvoice>(state.sub.invoices, SR.subscriptionInvoice, iid, { inv with amount = inv.amount + 1 });
  check(St.fingerprintHash(state) != before, "a proration moved without a block is a different fingerprint");
  RowStore.put<SR.SubscriptionInvoice>(state.sub.invoices, SR.subscriptionInvoice, iid, inv);
  check(St.fingerprintHash(state) == before, "restored again, the fingerprint is what it was");
};

// ── the counts ────────────────────────────────────────────────────────────────

var periodInvoices = 0; var prorations = 0;
switch (RowStore.pageById<SR.SubscriptionInvoice>(state.sub.invoices, SR.subscriptionInvoice, 0, 999_999_999, null, Page.MAX_LIMIT)) {
  case pg { for ((_, i) in pg.rows.vals()) { if (i.kind == #period) periodInvoices += 1 else prorations += 1 } };
};
Debug.print("count: subscriptions = " # Nat.toText(RowStore.size(state.sub.subscriptions)));
Debug.print("count: subscription runs = " # Nat.toText(RowStore.size(state.sub.runs)));
Debug.print("count: period invoices raised as orders = " # Nat.toText(periodInvoices));
Debug.print("count: prorations invoiced = " # Nat.toText(prorations));
Debug.print("count: period boundaries checked against the civil calendar = 9");
Debug.print("count: prorations checked to the minor unit = 6");
Debug.print("count: slices refused whole for a customer past their limit = 1");
Debug.print("count: refusals = " # Nat.toText(refusals));
Debug.print("count: blocks on the log = " # Nat.toText(DL.length(log)));

if (failures == 0) { Debug.print("SUBSCRIPTIONS GREEN") } else { Debug.print("FAIL: " # Nat.toText(failures) # " check(s) failed"); Runtime.trap("subscriptions battery failed") };
